# ─────────────────────────────────────────────────────────────────────────────
# Kasra Boutique — example environment. Copy to `.env.production` on the
# server and adjust. Never commit real values. No secrets are needed for the
# current frontend-only phase.
# ─────────────────────────────────────────────────────────────────────────────

# Public origin used for canonical URLs, sitemap and structured data.
# NEXT_PUBLIC_* values are inlined at BUILD time (pass them as build args).
NEXT_PUBLIC_SITE_URL=https://kasra.example

# Keep "false" for demo/staging. Set "true" only for the real production launch.
NEXT_PUBLIC_ALLOW_INDEXING=false

# Image tag deployed by docker compose (usually the git short SHA).
KASRA_TAG=latest

# Node heap for each frontend container (MB). Keep below the container memory limit.
NODE_OPTIONS=--max-old-space-size=1024

# ── Future backend integration (not used yet) ───────────────────────────────
# CATALOG_API_URL=https://api.internal.kasra.example
# CATALOG_API_TOKEN=            # inject via the server's secret store, never in git
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=   # required once Server Actions run on >1 instance
